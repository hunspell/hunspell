word "stem"
  lookup "stem" -> entry "stem" flags=P,S
  result correct
word "prefixstemsuffix"
  lookup "prefixstemsuffix" -> miss
  pfx flag=P strip="" add="prefix" cont=X cond="." at=aff:4 xprod=Y hdr=aff:3
    stem "stemsuffix"
    test condition cond="." on "stemsuffix" -> pass
    lookup "stemsuffix" -> miss
    sfx flag=S strip="" add="suffix" cont=X cond="." at=aff:7 xprod=Y hdr=aff:6
      stem "stem"
      test condition cond="." on "stem" -> pass
      lookup "stem" -> entry "stem" flags=P,S
      test sfx-aflag flag=S in=dic have=P,S -> pass
      test xprod flag=P in=dic have=P,S -> pass
      accept
  form "prefixstemsuffix" = pfx(P:"prefix") + "stem" + sfx(S:"suffix")
  result correct
word "prefixstem"
  lookup "prefixstem" -> miss
  pfx flag=P strip="" add="prefix" cont=X cond="." at=aff:4 xprod=Y hdr=aff:3
    stem "stem"
    test condition cond="." on "stem" -> pass
    lookup "stem" -> entry "stem" flags=P,S
    test pfx-aflag flag=P in=dic have=P,S -> pass
    test circumfix flag=X in=pfx-cont have=X -> fail, a circumfix prefix needs its suffix
    lookup "stem" -> no more homonyms
    sfx candidates=0 xprod=Y
  sfx candidates=0
  result incorrect
word "stemsuffix"
  lookup "stemsuffix" -> miss
  pfx candidates=0
  sfx flag=S strip="" add="suffix" cont=X cond="." at=aff:7 xprod=Y hdr=aff:6
    test circumfix flag=X pfx-cont=(none) sfx-cont=X -> fail, this circumfix suffix needs its prefix
  result incorrect
