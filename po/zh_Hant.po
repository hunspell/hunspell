#: src/tools/hunspell.cxx:1923
msgid "Usage: hunspell [OPTION]... [FILE]...\n"
msgstr "用法：hunspell [選項]... [檔案]...\n"

#: src/tools/hunspell.cxx:1924
msgid ""
"Check spelling of each FILE. Without FILE, check standard input.\n"
"\n"
msgstr ""
"檢查每個檔案的文字拼寫。如果沒有指定檔案，將檢查標準輸入。\n"
"\n"

#: src/tools/hunspell.cxx:1926
msgid "  -1\t\tcheck only first field in lines (delimiter = tabulator)\n"
msgstr "  -1\t\t只檢查行中第一個欄位（分隔字元 = TAB）\n"

#: src/tools/hunspell.cxx:1928
msgid "  -a\t\tIspell's pipe interface\n"
msgstr "  -a\t\tIspell 的管道介面\n"

#: src/tools/hunspell.cxx:1929
msgid "  --check-url\tcheck URLs, e-mail addresses and directory paths\n"
msgstr "  --check-url\t檢查 URL、電子信箱地址、目錄路徑\n"

#: src/tools/hunspell.cxx:1934
msgid "  --check-apostrophe\tcheck Unicode typographic apostrophe\n"
msgstr "  --check-apostrophe\t檢查 Unicode 印刷體撇號\n"

#: src/tools/hunspell.cxx:1936
msgid "  -d d[,d2,...]\tuse d (d2 etc.) dictionaries\n"
msgstr "  -d d[,d2,...]\t使用詞典 d (、d2、等等)\n"

#: src/tools/hunspell.cxx:1937
msgid "  -D\t\tshow available dictionaries\n"
msgstr "  -D\t\t顯示可用的詞典\n"

#: src/tools/hunspell.cxx:1938
