msgstr "  -L\t\tlínte a phriontáil le focail mhílitrithe\n"

#: src/tools/hunspell.cxx:1945
msgid "  -m \t\tanalyze the words of the input text\n"
msgstr "  -m \t\tanailís a dhéanamh ar fhocail an téacs ionchuir\n"

#: src/tools/hunspell.cxx:1946
msgid "  -n\t\tnroff/troff input file format\n"
msgstr "  -n\t\tformáid comhaid ionchuir nroff/troff\n"

#: src/tools/hunspell.cxx:1950
msgid "  -O\t\tOpenDocument (ODF or Flat ODF) input file format\n"
msgstr "  -O\t\tFormáid comhaid ionchuir OpenDocument (ODF nó Flat ODF)\n"

#: src/tools/hunspell.cxx:1951
msgid "  -p dict\tset dict custom dictionary\n"
msgstr "  -p dict\tsocraigh foclóir saincheaptha dict\n"

#: src/tools/hunspell.cxx:1953
msgid ""
"  --no-default-personal\n"
"\t\tdon't use the default personal dictionary\n"
msgstr ""

#: src/tools/hunspell.cxx:1956
msgid "  -r\t\twarn of the potential mistakes (rare words)\n"
msgstr ""
"  -r\t\trabhadh a thabhairt faoi na botúin a d'fhéadfadh a bheith ann "
"(focail neamhchoitianta)\n"

#: src/tools/hunspell.cxx:1959
msgid "  -P password\tset password for encrypted dictionaries\n"
msgstr "  -P password\tsocraigh pasfhocal le haghaidh foclóirí criptithe\n"

#: src/tools/hunspell.cxx:1960
msgid "  -s \t\tstem the words of the input text\n"
msgstr "  -s \t\tcuir tús le focail an téacs ionchuir\n"

#: src/tools/hunspell.cxx:1961
msgid "  -S \t\tsuffix words of the input text\n"
msgstr "  -S \t\tfocail iarmhír an téacs ionchuir\n"

#: src/tools/hunspell.cxx:1962
msgid "  -t\t\tTeX/LaTeX input file format\n"
msgstr "  -t\t\tFormáid comhaid ionchuir TeX/LaTeX\n"

#: src/tools/hunspell.cxx:1964
msgid "  --trace\treport how each input word was decided\n"
msgstr ""

