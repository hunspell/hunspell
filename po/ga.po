msgstr "  -D\t\ttaispeáin na foclóirí atá ar fáil\n"

#: src/tools/hunspell.cxx:1938
msgid "  -G\t\tprint only correct words or lines\n"
msgstr "  -G\t\tpriontáil focail nó línte cearta amháin\n"

#: src/tools/hunspell.cxx:1939
msgid "  -h, --help\tdisplay this help and exit\n"
msgstr "  -h, --help\ttaispeáin an chabhair seo agus scoir\n"

#: src/tools/hunspell.cxx:1940
msgid "  -H\t\tHTML input file format\n"
msgstr "  -H\t\tFormáid comhaid ionchuir HTML\n"

#: src/tools/hunspell.cxx:1941
