msgstr "  -s \t\ttigigi la vortojn de la eniga teksto\n"

#: src/tools/hunspell.cxx:1961
msgid "  -S \t\tsuffix words of the input text\n"
msgstr "  -S \t\tsufiksigi vortojn de la eniga teksto\n"

#: src/tools/hunspell.cxx:1962
