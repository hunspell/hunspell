"U)končiť alebo ? pre pomoc\n"

#: src/tools/hunspell.cxx:1363
msgid ""
"Whenever a word is found that is not in the dictionary\n"
"it is printed on the first line of the screen.  If the dictionary\n"
"contains any similar words, they are listed with a number\n"
"next to each one.  You have the option of replacing the word\n"
"completely, or choosing one of the suggested words.\n"
msgstr ""
"Keď se narazí na slovo, ktoré nie je v slovníku,\n"
"je vypísané na prvom riadku obrazovky. Ak slovník\n"
"obsahuje podobné slová, sú vypísané spoločne s číslami\n"
"týchto volieb. Slovo môžete úplne nahradiť, alebo zvoliť\n"
"z tých odporúčaných.\n"

#: src/tools/hunspell.cxx:1369
msgid ""
"\n"
"Commands are:\n"
"\n"
msgstr ""
"\n"
"Príkazy sú:\n"
"\n"

#: src/tools/hunspell.cxx:1370
msgid "R\tReplace the misspelled word completely.\n"
msgstr "R\tÚplne nahraď skomolené slovo.\n"

#: src/tools/hunspell.cxx:1371
msgid "Space\tAccept the word this time only.\n"
msgstr "Space\tPrijať slovo pre tento krát.\n"

#: src/tools/hunspell.cxx:1373
msgid "A\tAccept the word for the rest of this session.\n"
msgstr "A\tPrijať slovo po zbytok relácie.\n"

#: src/tools/hunspell.cxx:1375
msgid "I\tAccept the word, and put it in your private dictionary.\n"
msgstr "I\tPrijať slovo, a pridať ho do osobného slovníka.\n"

#: src/tools/hunspell.cxx:1377
msgid "U\tAccept and add lowercase version to private dictionary.\n"
msgstr "U\tPrijať a pridať verziu s malými písmenami do osobného slovníka.\n"

#: src/tools/hunspell.cxx:1379
msgid ""
"S\tAsk a stem and a model word and store them in the private dictionary.\n"
"\tThe stem will be accepted also with the affixes of the model word.\n"
msgstr ""
"S\tVypýtať si koreň a modelové slovo a uložiť ich do osobného slovníka.\n"
"\tKoreň bude prijatý aj s príponami modelového slova.\n"

#: src/tools/hunspell.cxx:1383
msgid "0-n\tReplace with one of the suggested words.\n"
msgstr "0-n\tNahradiť jedným z navrhovaných slov.\n"

#: src/tools/hunspell.cxx:1385
msgid ""
"X\tWrite the rest of this file, ignoring misspellings, and start next file.\n"
msgstr ""
"X\tZapísať zbytok súboru, ignorovať pravopisné chyby, a začať s novým "
"súborom.\n"

#: src/tools/hunspell.cxx:1388
msgid "Q\tQuit immediately. Asks for confirmation. Leaves file unchanged.\n"
msgstr ""
"Q\tOkamžite ukončiť. Opýtať sa na potvrdenie. Súbor nechať nezmenený.\n"

#: src/tools/hunspell.cxx:1390
msgid "^Z\tSuspend program. Restart with fg command.\n"
msgstr "^Z\tPozastaví program. Reštart s príkazom fg.\n"

#: src/tools/hunspell.cxx:1391
msgid "?\tShow this help screen.\n"
msgstr "?\tZobraziť túto nápovedu.\n"

#: src/tools/hunspell.cxx:1392
msgid ""
"\n"
"-- Type space to continue -- \n"
msgstr ""
"\n"
"-- Pokračujte stlačením medzerníka -- \n"

