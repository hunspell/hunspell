#: src/tools/hunspell.cxx:1686
msgid "Can't create tempfile"
msgstr "டெம்பைலை உருவாக்க முடியாது"

#: src/tools/hunspell.cxx:1731
msgid "Can't open outputfile"
msgstr "வெளியீட்டு கோப்பைத் திறக்க முடியாது"

#: src/tools/hunspell.cxx:1923
msgid "Usage: hunspell [OPTION]... [FILE]...\n"
msgstr "பயன்பாடு: அன்ச்பெல் [விருப்பம்] ... [கோப்பு] ...\n"

#: src/tools/hunspell.cxx:1924
msgid ""
"Check spelling of each FILE. Without FILE, check standard input.\n"
"\n"
msgstr ""
"ஒவ்வொரு கோப்பின் எழுத்துப்பிழை சரிபார்க்கவும். கோப்பு இல்லாமல், நிலையான உள்ளீட்டை "
"சரிபார்க்கவும்.\n"
"\n"

#: src/tools/hunspell.cxx:1926
msgid "  -1\t\tcheck only first field in lines (delimiter = tabulator)\n"
msgstr "  -1 வரிகளில் முதல் புலத்தை மட்டுமே சரிபார்க்கவும் (டிலிமிட்டர் = டேபுலேட்டர்)\n"

#: src/tools/hunspell.cxx:1928
msgid "  -a\t\tIspell's pipe interface\n"
msgstr "  -ஒ இச்பெல்லின் குழாய் இடைமுகம்\n"

#: src/tools/hunspell.cxx:1929
msgid "  --check-url\tcheck URLs, e-mail addresses and directory paths\n"
msgstr "  -CHECK-URL காசோலை முகவரி கள், மின்னஞ்சல் முகவரிகள் மற்றும் அடைவு பாதைகள்\n"

#: src/tools/hunspell.cxx:1934
msgid "  --check-apostrophe\tcheck Unicode typographic apostrophe\n"
msgstr "  -சேக்-அபோச்ட்ரோஃப் யூனிகோட் அச்சுக்கலை அப்போச்ட்ரோபியை சரிபார்க்கவும்\n"

#: src/tools/hunspell.cxx:1936
msgid "  -d d[,d2,...]\tuse d (d2 etc.) dictionaries\n"
msgstr "  -d டி [, d2, ...] டி (d2 போன்றவை) அகராதிகளைப் பயன்படுத்துங்கள்\n"

#: src/tools/hunspell.cxx:1937
msgid "  -D\t\tshow available dictionaries\n"
msgstr "  கிடைக்கக்கூடிய அகராதிகளைக் காட்டு\n"

#: src/tools/hunspell.cxx:1938
msgid "  -G\t\tprint only correct words or lines\n"
msgstr "  -G அச்சு சரியான சொற்கள் அல்லது வரிகளை மட்டும் அச்சிடவும்\n"

#: src/tools/hunspell.cxx:1939
msgid "  -h, --help\tdisplay this help and exit\n"
msgstr "  -h, -உதவி இந்த உதவியைக் காண்பி வெளியேறவும்\n"

#: src/tools/hunspell.cxx:1940
msgid "  -H\t\tHTML input file format\n"
msgstr "  -H உஉகுமொ உள்ளீட்டு கோப்பு வடிவம்\n"

#: src/tools/hunspell.cxx:1941
msgid "  -i enc\tinput encoding\n"
msgstr "  -i enc உள்ளீட்டு குறியாக்கம்\n"

#: src/tools/hunspell.cxx:1942
msgid "  -l\t\tprint misspelled words\n"
msgstr "  -எல் அச்சு தவறாக எழுதப்பட்ட சொற்கள்\n"

#: src/tools/hunspell.cxx:1943
msgid "  -L\t\tprint lines with misspelled words\n"
msgstr "  -எல் தவறாக எழுதப்பட்ட சொற்களுடன் கோடுகள்\n"

#: src/tools/hunspell.cxx:1945
msgid "  -m \t\tanalyze the words of the input text\n"
msgstr "  உள்ளீட்டு உரையின் சொற்களை பகுப்பாய்வு செய்யுங்கள்\n"

#: src/tools/hunspell.cxx:1946
msgid "  -n\t\tnroff/troff input file format\n"
msgstr "  -n nroff/டிராஃப் உள்ளீட்டு கோப்பு வடிவம்\n"

#: src/tools/hunspell.cxx:1950
msgid "  -O\t\tOpenDocument (ODF or Flat ODF) input file format\n"
msgstr "  -O opendocument (ODF அல்லது பிளாட் ODF) உள்ளீட்டு கோப்பு வடிவம்\n"

#: src/tools/hunspell.cxx:1951
msgid "  -p dict\tset dict custom dictionary\n"
msgstr "  -p டிக்ட் செட் டிக்ட் தனிப்பயன் அகராதி\n"

#: src/tools/hunspell.cxx:1953
msgid ""
"  --no-default-personal\n"
"\t\tdon't use the default personal dictionary\n"
msgstr ""

#: src/tools/hunspell.cxx:1956
msgid "  -r\t\twarn of the potential mistakes (rare words)\n"
msgstr "  சாத்தியமான தவறுகளை எச்சரிக்கவும் (அரிய சொற்கள்)\n"

#: src/tools/hunspell.cxx:1959
msgid "  -P password\tset password for encrypted dictionaries\n"
msgstr "  -P கடவுச்சொல் மறைகுறியாக்கப்பட்ட அகராதிகளுக்கு கடவுச்சொல்லை அமைக்கவும்\n"

#: src/tools/hunspell.cxx:1960
msgid "  -s \t\tstem the words of the input text\n"
msgstr "  -S உள்ளீட்டு உரையின் சொற்களைத் தடுக்கவும்\n"

#: src/tools/hunspell.cxx:1961
msgid "  -S \t\tsuffix words of the input text\n"
msgstr "  உள்ளீட்டு உரையின் பின்னொட்டு சொற்கள்\n"

#: src/tools/hunspell.cxx:1962
msgid "  -t\t\tTeX/LaTeX input file format\n"
msgstr "  -T டெக்ச்/லேடெக்ச் உள்ளீட்டு கோப்பு வடிவம்\n"

#: src/tools/hunspell.cxx:1964
msgid "  --trace\treport how each input word was decided\n"
msgstr ""

#: src/tools/hunspell.cxx:1966
#, fuzzy
#| msgid "  -L\t\tprint lines with misspelled words\n"
msgid "  -u\t\tprint the line number, misspelled word and first suggestion\n"
msgstr "  -எல் தவறாக எழுதப்பட்ட சொற்களுடன் கோடுகள்\n"

#: src/tools/hunspell.cxx:1969
msgid ""
"  -U\t\tprint the input text with each misspelled word replaced by its\n"
"\t\tfirst suggestion\n"
msgstr ""

#: src/tools/hunspell.cxx:1972
msgid "  -u2\t\tprint the replacements that -U would make, as a sed script\n"
msgstr ""

#: src/tools/hunspell.cxx:1975
#, fuzzy
#| msgid "  -L\t\tprint lines with misspelled words\n"
msgid ""
"  -u3\t\tprint the file name and line number with each misspelled word\n"
msgstr "  -எல் தவறாக எழுதப்பட்ட சொற்களுடன் கோடுகள்\n"

#: src/tools/hunspell.cxx:1977
msgid "  -v, --version\tprint version number\n"
msgstr "  -v, -பதிப்பு அச்சு பதிப்பு எண்\n"

#: src/tools/hunspell.cxx:1979
msgid "  -vv\t\tprint Ispell compatible version number\n"
msgstr "  -VV அச்சு ISPELL இணக்கமான பதிப்பு எண்\n"

#: src/tools/hunspell.cxx:1980
msgid "  -w\t\tprint misspelled words (= lines) from one word/line input.\n"
msgstr "  -w ஒரு சொல்/வரி உள்ளீட்டிலிருந்து தவறாக எழுதப்பட்ட சொற்கள் (= கோடுகள்).\n"

#: src/tools/hunspell.cxx:1982
msgid ""
"  -X\t\tXML input file format\n"
"\n"
msgstr ""
"  -X நீகுமொ உள்ளீட்டு கோப்பு வடிவம்\n"
"\n"

#: src/tools/hunspell.cxx:1986
msgid ""
"Example: hunspell -d en_US file.txt    # interactive spelling\n"
"         hunspell -i utf-8 file.txt    # check UTF-8 encoded file\n"
"         hunspell -l *.odt             # print misspelled words of ODF "
"files\n"
"\n"
"         # Quick fix of ODF documents by personal dictionary creation\n"
"\n"
"         # 1 Make a reduced list from misspelled and unknown words:\n"
"\n"
"         hunspell -l *.odt | sort | uniq >words\n"
"\n"
"         # 2 Delete misspelled words of the file by a text editor.\n"
"         # 3 Use this personal dictionary to fix the deleted words:\n"
"\n"
"         hunspell -p words *.odt\n"
"\n"
msgstr ""
"எடுத்துக்காட்டு: அன்ச்பெல் -டி en_us file.txt # ஊடாடும் எழுத்துப்பிழை\n"
" அன்ச்பெல் -i UTF-8 File.TXT # UTF-8 குறியிடப்பட்ட கோப்பை சரிபார்க்கவும்\n"
" அன்ச்பெல் -எல் *.odt # அச்சு ODF கோப்புகளின் தவறாக எழுதப்பட்ட சொற்களை அச்சிடவும்\n"
"\n"
" தனிப்பட்ட அகராதி உருவாக்கத்தால் ODF ஆவணங்களை விரைவாக சரிசெய்தல்\n"
"\n"
" # 1 தவறாக எழுதப்பட்ட மற்றும் அறியப்படாத சொற்களிலிருந்து குறைக்கப்பட்ட பட்டியலை "
"உருவாக்கவும்:\n"
"\n"
" அன்ச்பெல் -எல் *.odt | வரிசைப்படுத்துதல் | UNIQ> சொற்கள்\n"
"\n"
" # 2 உரை எடிட்டரால் கோப்பின் தவறாக எழுதப்பட்ட சொற்களை நீக்கு.\n"
" # 3 நீக்கப்பட்ட சொற்களை சரிசெய்ய இந்த தனிப்பட்ட அகராதியைப் பயன்படுத்தவும்:\n"
"\n"
" அன்ச்பெல் -p சொற்கள் *.ஓடி\n"
"\n"

